// Example policy for @modelcontextprotocol/server-memory 1.0.0.
//
// Pins the reviewed tool surface; no host paths. Extend it and add the
// host's `defaults` (node prefix, node_modules read access, and the
// directory holding MEMORY_FILE_PATH with mode="write") — see
// docs/policy-authoring.md. tests/real_servers_e2e.rs does the same.
//
// The server's data file is chosen by the MEMORY_FILE_PATH environment
// variable, not by an RPC argument: the Auditor cannot scope it per-tool.
// Keep its directory in `defaults.filesystem` and treat every write tool
// below as sharing that file.
//
// If the host policy declares `defaults.environment`, MEMORY_FILE_PATH must
// be listed there (`environment { allow "MEMORY_FILE_PATH" }`) or the child
// falls back to memory.jsonl inside the read-only package directory.
extends "runtime/node.kdl"
policy version=1

defaults {
    network {
        deny host="*"
    }
}

server "memory" {
    // Pinned against @modelcontextprotocol/server-memory 1.0.0
    // (negotiated MCP 2025-11-25, 9 tools, mcp-guard-tools-list-v4).
    tools-list-hash "sha256:75e8f7889cc05510689e9fe237983e2ae9490155eb38aab8a99b5396a047b1f8"

    // Every tool declares an explicit empty filesystem block: without it the
    // host `defaults.filesystem` grants would be inherited per-tool, making
    // these pathless tools require a path argument they do not have.
    tool "create_entities" side_effect="write" {
        filesystem {
            allow none=#true
            require-path #false
        }
    }
    tool "create_relations" side_effect="write" {
        filesystem {
            allow none=#true
            require-path #false
        }
    }
    tool "add_observations" side_effect="write" {
        filesystem {
            allow none=#true
            require-path #false
        }
    }
    tool "delete_entities" side_effect="write" {
        filesystem {
            allow none=#true
            require-path #false
        }
    }
    tool "delete_observations" side_effect="write" {
        filesystem {
            allow none=#true
            require-path #false
        }
    }
    tool "delete_relations" side_effect="write" {
        filesystem {
            allow none=#true
            require-path #false
        }
    }
    tool "read_graph" side_effect="read_only" {
        filesystem {
            allow none=#true
            require-path #false
        }
    }
    tool "search_nodes" side_effect="read_only" {
        filesystem {
            allow none=#true
            require-path #false
        }
    }
    tool "open_nodes" side_effect="read_only" {
        filesystem {
            allow none=#true
            require-path #false
        }
    }
}
