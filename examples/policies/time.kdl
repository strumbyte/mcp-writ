// Example policy for mcp-server-time 2026.8.18.
//
// Pins the reviewed tool surface; no host paths. Extend it and add the
// host's `defaults` (interpreter prefix + venv read access) — see
// docs/policy-authoring.md. tests/real_servers_e2e.rs does the same.
// The server performs no filesystem or network I/O; the tool arguments are
// timezone names and HH:MM strings, so there are no per-tool path rules.
extends "runtime/python.kdl"
policy version=1

defaults {
    network {
        deny host="*"
    }
}

server "time" {
    // Pinned against mcp-server-time 2026.8.18
    // (negotiated MCP 2025-11-25, 2 tools, mcp-guard-tools-list-v4).
    tools-list-hash "sha256:be763b48bfee1ccabf75d095bf48a22b52b504a29ec36c8261fbb4842429017b"

    // Explicit empty filesystem blocks: without them the host
    // `defaults.filesystem` grants would be inherited per-tool, and these
    // pathless tools would then require a path argument they do not have.
    tool "get_current_time" side_effect="read_only" {
        filesystem {
            allow none=#true
            require-path #false
        }
    }
    tool "convert_time" side_effect="read_only" {
        filesystem {
            allow none=#true
            require-path #false
        }
    }
}
